# ==================== AUTH (Clerk) ====================
# Mesmas chaves do frontend rr-engine-app (.env.local)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ==================== DATABASE ====================
# MySQL/TiDB Cloud (gateway02.us-east-1.prod.aws.tidbcloud.com)
DATABASE_URL=mysql://user:pass@host:4000/rr_engine?ssl={"rejectUnauthorized":true}

# ==================== LLM ====================
# Pelo menos uma das duas opções abaixo:
# Opção A — Anthropic direto (recomendado pra Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Opção B — Forge da Manus (proxy multi-provider)
# Quando ANTHROPIC_API_KEY existe e o modelo é Claude, vai direto na Anthropic.
# Senão, vai pelo Forge.
BUILT_IN_FORGE_API_URL=https://forge.manus.im/v1/chat/completions
BUILT_IN_FORGE_API_KEY=

LLM_MODEL=gemini-2.5-flash
LLM_MODEL_CRITICAL=claude-opus-4-6
LLM_MODEL_INTERMEDIATE=claude-sonnet-4-6

# ==================== STRIPE ====================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==================== AWS S3 ====================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=rr-engine-files

# ==================== CORS ====================
# CSV de origins permitidas. Default em produção:
# https://engine.rres.com.br,https://www.engine.rres.com.br
CORS_ORIGINS=https://engine.rres.com.br

# ==================== OBSERVABILIDADE (opcional) ====================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ==================== RUNTIME ====================
NODE_ENV=production
PORT=3000
# SERVE_FRONTEND=true  # apenas se quiser servir SPA legacy a partir deste servidor
